SPARKLE_APPCAST_URL = $(inherited)
SPARKLE_PUBLIC_ED_KEY = $(inherited)
TRAE_FLOW_TELEMETRY_SLS_HOST = $(inherited)
TRAE_FLOW_TELEMETRY_SLS_PROJECT = $(inherited)
TRAE_FLOW_TELEMETRY_SLS_LOGSTORE = $(inherited)
TRAE_FLOW_TELEMETRY_SLS_TOPIC = product-telemetry
TRAE_FLOW_TELEMETRY_SLS_SOURCE = cc-flow-macos
TRAE_FLOW_TELEMETRY_DAILY_EVENT_LIMIT = 200

// New CC FLOW names. Command-line/CI CC_FLOW_* values take precedence;
// existing TRAE_FLOW_* secrets remain valid as fallbacks.
CC_FLOW_TELEMETRY_SLS_HOST = $(TRAE_FLOW_TELEMETRY_SLS_HOST)
CC_FLOW_TELEMETRY_SLS_PROJECT = $(TRAE_FLOW_TELEMETRY_SLS_PROJECT)
CC_FLOW_TELEMETRY_SLS_LOGSTORE = $(TRAE_FLOW_TELEMETRY_SLS_LOGSTORE)
CC_FLOW_TELEMETRY_SLS_TOPIC = $(TRAE_FLOW_TELEMETRY_SLS_TOPIC)
CC_FLOW_TELEMETRY_SLS_SOURCE = cc-flow-macos
CC_FLOW_TELEMETRY_DAILY_EVENT_LIMIT = $(TRAE_FLOW_TELEMETRY_DAILY_EVENT_LIMIT)

// Local CC_FLOW_* values override the fallbacks above. Legacy local
// TRAE_FLOW_* values still flow through the variable references.
#include? "LocalSecrets.xcconfig"
